generator client {
  provider = "prisma-client-js"
    binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model attendance {
  id              Int         @id @default(autoincrement())
  enrollment_id   Int
  status          String?     @db.VarChar(20)
  created_at      DateTime?   @default(now()) @db.DateTime(0)
  attendance_date DateTime    @db.Date
  modified_at     DateTime?   @default(now()) @db.DateTime(0)
  enrollments     enrollments @relation(fields: [enrollment_id], references: [id], map: "fk_attendance_enrollment_id")

  @@index([enrollment_id], map: "fk_attendance_enrollment_id_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model batches {
  id                Int                 @id @default(autoincrement())
  name              String              @db.VarChar(255)
  branch_id         Int
  weekdays          String?             @db.VarChar(50)
  start_time        DateTime?           @db.Time(0)
  end_time          DateTime?           @db.Time(0)
  max_students      Int                 @default(0)
  medium            batches_medium
  status            batches_status?
  created_at        DateTime?           @default(now()) @db.DateTime(0)
  modified_at       DateTime?           @default(now()) @db.DateTime(0)
  branches          branches            @relation(fields: [branch_id], references: [id], map: "fk_batches_branch_id")
  enrollmentbatches enrollmentbatches[]
  staffmappings     staffmappings[]

  @@index([branch_id], map: "fk_batches_branch_id_idx")
}

model branches {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(255)
  contact_email String?         @db.VarChar(255)
  phone         String?         @db.VarChar(50)
  address       String?         @db.Text
  gst           String?         @db.VarChar(100)
  tenant_id     Int
  created_at    DateTime?       @default(now()) @db.DateTime(0)
  modified_at   DateTime?       @default(now()) @db.DateTime(0)
  batches       batches[]
  invoices      invoices[]
  students      students[]
  tenantbilling tenantbilling[]
}

model courseprogress {
  id              Int                   @id @default(autoincrement())
  course_topic_id Int
  enrollment_id   Int
  status          courseprogress_status
  completed_on    DateTime?             @default(now()) @db.Timestamp(0)
  created_at      DateTime?             @default(now()) @db.DateTime(0)
  modified_at     DateTime?             @default(now()) @db.DateTime(0)
  coursetopics    coursetopics          @relation(fields: [course_topic_id], references: [id], map: "fk_courseprogress_course_topic_id")
  enrollments     enrollments           @relation(fields: [enrollment_id], references: [id], map: "fk_courseprogress_enrollment_id")

  @@index([enrollment_id], map: "fk_courseprogress_enrollment_id_idx")
  @@index([course_topic_id], map: "fk_courseprogress_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model coursetopics {
  id                Int                @id @default(autoincrement())
  course_topic_name String?            @db.VarChar(100)
  product_id        Int
  parent_id         Int                @default(0)
  created_at        DateTime?          @default(now()) @db.Timestamp(0)
  modified_at       DateTime?          @default(now()) @db.Timestamp(0)
  isactive          Int?               @default(1) @db.TinyInt
  courseevaluation  courseevaluation[]
  courseprogress    courseprogress[]
  products          products           @relation(fields: [product_id], references: [id], map: "fk_topics_productid")

  @@index([product_id], map: "fk_topics_productid_idx")
}

model enrollmentbatches {
  id            Int         @id @default(autoincrement())
  enrollment_id Int
  batch_id      Int
  created_at    DateTime?   @default(now()) @db.DateTime(0)
  modified_at   DateTime?   @default(now()) @db.DateTime(0)
  batches       batches     @relation(fields: [batch_id], references: [id], map: "fk_enrollmentbatches_batch_id")
  enrollments   enrollments @relation(fields: [enrollment_id], references: [id], map: "fk_enrollmentbatches_enrollment_id")

  @@index([batch_id], map: "fk_enrollmentbatches_batch_id_idx")
  @@index([enrollment_id], map: "fk_enrollmentbatches_enrollment_id_idx")
}

model enrollments {
  id                Int                 @id @default(autoincrement())
  product_id        Int?
  student_id        Int
  enrolled_date     DateTime?           @db.DateTime(0)
  completed_date    DateTime?           @db.DateTime(0)
  dropped_date      DateTime?           @db.DateTime(0)
  start_date        DateTime?           @db.Date
  end_date          DateTime?           @db.Date
  status            enrollments_status?
  created_at        DateTime?           @default(now()) @db.DateTime(0)
  modified_at       DateTime?           @default(now()) @db.DateTime(0)
  attendance        attendance[]
  courseevaluation  courseevaluation[]
  courseprogress    courseprogress[]
  enrollmentbatches enrollmentbatches[]
  products          products?            @relation(fields: [product_id], references: [id], map: "fk_enrollments_product_id")
  students          students            @relation(fields: [student_id], references: [id], map: "fk_enrollments_student_id")
  invoices          invoices[]

  @@index([product_id], map: "fk_enrollments_product_id_idx")
  @@index([student_id], map: "fk_enrollments_student_id_idx")
}

model invoices {
  id                 Int                  @id @default(autoincrement())
  branch_id          Int
  product_id         Int
  period_start       DateTime?            @db.Date
  period_end         DateTime?            @db.Date
  due_date           DateTime?            @db.Date
  amount             Decimal              @db.Decimal(10, 2)
  status             invoices_status?
  created_at         DateTime?            @default(now()) @db.DateTime(0)
  enrollment_id      Int
  invoice_date       DateTime             @db.DateTime(0)
  invoice_no         String?              @db.VarChar(45)
  modified_at        DateTime?            @default(now()) @db.DateTime(0)
  enrollmentpayments enrollmentpayments[]
  branches           branches             @relation(fields: [branch_id], references: [id], map: "fk_invoices_branch_id")
  enrollments        enrollments          @relation(fields: [enrollment_id], references: [id], map: "fk_invoices_enrollment_id")
  products           products             @relation(fields: [product_id], references: [id], map: "fk_invoices_product_id")
  payments           payments[]

  @@index([branch_id], map: "fk_invoices_branch_id_idx")
  @@index([enrollment_id], map: "fk_invoices_enrollment_id_idx")
  @@index([product_id], map: "fk_invoices_product_id_idx")
}

model notifications {
  id         Int       @id @default(autoincrement())
  branch_id  Int
  title      String?   @db.VarChar(255)
  message    String?   @db.Text
  type       String?   @db.VarChar(50)
  created_at DateTime? @default(now()) @db.DateTime(0)
  batch_id   Int?
  student_id Int?
}

model paymentoptions {
  id                 Int                  @id @default(autoincrement())
  name               String               @db.VarChar(255)
  created_at         DateTime?            @default(now()) @db.DateTime(0)
  modified_at        DateTime?            @default(now()) @db.DateTime(0)
  enrollmentpayments enrollmentpayments[]
  tenantpayments     tenantpayments[]
}

model payments {
  id          Int       @id @default(autoincrement())
  invoice_id  Int
  paid_on     DateTime? @db.DateTime(0)
  transaction String?   @db.VarChar(50)
  comments    String?   @db.VarChar(1000)
  created_at  DateTime? @default(now()) @db.DateTime(0)
  modified_at DateTime? @default(now()) @db.DateTime(0)
  invoices    invoices  @relation(fields: [invoice_id], references: [id], map: "fk_payments_invoice_id")

  @@index([invoice_id], map: "fk_payments_invoice_id_idx")
}

model productfees {
  id          Int       @id @default(autoincrement())
  product_id  Int
  fee         Decimal   @db.Decimal(10, 2)
  start_date  DateTime? @db.Date
  end_date    DateTime? @db.Date
  created_at  DateTime? @default(now()) @db.DateTime(0)
  modified_at DateTime? @default(now()) @db.DateTime(0)
  products    products  @relation(fields: [product_id], references: [id], map: "fk_productfees_product_id")

  @@index([product_id], map: "fk_productfees_product_id_idx")
}

model products {
  id            Int              @id @default(autoincrement())
  branch_id     Int
  name          String           @db.VarChar(255)
  description   String?          @db.Text
  max_classes   Int?
  comp_classes  Int?
  start_date    DateTime?        @db.Date
  end_date      DateTime?        @db.Date
  created_at    DateTime?        @default(now()) @db.DateTime(0)
  status        products_status?
  modified_at   DateTime?        @default(now()) @db.DateTime(0)
  coursetopics  coursetopics[]
  enrollments   enrollments[]
  invoices      invoices[]
  productfees   productfees[]
  staffmappings staffmappings[]
}

model staff {
  id             Int                 @id @default(autoincrement())
  name           String              @db.VarChar(300)
  qualification  String?             @db.VarChar(100)
  experience     String?             @db.VarChar(100)
  specialization String?             @db.VarChar(100)
  salary         Decimal?            @db.Decimal(10, 2)
  start_date     DateTime?           @db.Date
  end_date       DateTime?           @db.Date
  branch_id      Int
  user_id        Int?                @unique
  created_at     DateTime?           @default(now()) @db.DateTime(0)
  email          String?             @db.VarChar(100)
  modified_at    DateTime?           @default(now()) @db.DateTime(0)
  phone          String?             @db.VarChar(25)
  staff_status   staff_staff_status?
  staff_title    staff_staff_title?
  staffmappings  staffmappings[]
  users          users?              @relation(fields: [user_id], references: [id], onDelete: SetNull, map: "fk_staff_user_id")
}

model staffmappings {
  id          Int       @id @default(autoincrement())
  batch_id    Int
  product_id  Int?
  staff_id    Int
  created_at  DateTime  @db.DateTime(0)
  modified_at DateTime? @default(now()) @db.DateTime(0)
  batches     batches   @relation(fields: [batch_id], references: [id], map: "fk_staffmapping_batch_id")
  products    products? @relation(fields: [product_id], references: [id], onDelete: Restrict, map: "fk_staffmapping_product_id")
  staff       staff     @relation(fields: [staff_id], references: [id], map: "fk_staffmapping_staff_id")

  @@index([batch_id], map: "fk_staffmapping_batch_id_idx")
  @@index([product_id], map: "fk_staffmapping_product_id_idx")
  @@index([staff_id], map: "fk_staffmapping_staff_id_idx")
}

model students {
  id                      Int           @id @default(autoincrement())
  branch_id               Int
  name                    String        @db.VarChar(255)
  email                   String?       @db.VarChar(255)
  phone                   String?       @db.VarChar(50)
  address                 String?       @db.Text
  parent_guardian_name    String?       @db.VarChar(255)
  parent_guardian_contact String?       @db.VarChar(50)
  parent_guardian_email   String?       @db.VarChar(255)
  status                  String?       @db.VarChar(50)
  created_at              DateTime?     @default(now()) @db.DateTime(0)
  modified_at             DateTime?     @default(now()) @db.DateTime(0)
  enrollments             enrollments[]
  branches                branches      @relation(fields: [branch_id], references: [id], map: "fk_students_branch_id")

  @@index([branch_id], map: "fk_students_branch_id_idx")
}

model tenants {
  id                  Int                   @id @default(autoincrement())
  name                String                @db.VarChar(255)
  contact_email       String?               @db.VarChar(255)
  phone               String?               @db.VarChar(50)
  address             String?               @db.Text
  gst                 String?               @db.VarChar(100)
  created_at          DateTime?             @default(now()) @db.DateTime(0)
  modified_at         DateTime?             @default(now()) @db.DateTime(0)
  tenantsubscriptions tenantsubscriptions[]
  users               users[]
}

model tenantsubscriptions {
  id                        Int                     @id @default(autoincrement())
  tenant_id                 Int
  start_date                DateTime                @db.Date
  end_date                  DateTime?               @db.Date
  created_at                DateTime?               @default(now()) @db.DateTime(0)
  modified_at               DateTime?               @default(now()) @db.DateTime(0)
  tenantsubscriptiontier_id Int
  tenants                   tenants                 @relation(fields: [tenant_id], references: [id], map: "fk_ tenantsubscriptions_tenant_id")
  tenantsubscriptiontiers   tenantsubscriptiontiers @relation(fields: [tenantsubscriptiontier_id], references: [id], map: "fk_tenantsubscriptions_tenantsubscriptiontier_id")

  @@index([tenant_id], map: "fk_ tenantsubscriptions_tenant_id_idx")
  @@index([tenantsubscriptiontier_id], map: "fk_tenantsubscriptions_tenantsubscriptiontier_id_idx")
}

model users {
  id          Int       @id @default(autoincrement())
  tenant_id   Int?
  name        String    @db.VarChar(255)
  email       String    @unique(map: "email") @db.VarChar(255)
  password    String    @db.VarChar(255)
  role        String    @db.VarChar(50)
  is_active   Boolean?  @default(true)
  created_at  DateTime? @default(now()) @db.DateTime(0)
  modified_at DateTime? @default(now()) @db.DateTime(0)
  tenants     tenants?  @relation(fields: [tenant_id], references: [id], onDelete: Restrict, map: "fk_users_tenant_id")
  staff       staff?
  @@index([tenant_id], map: "fk_users_tenant_id_idx")
}

model courseevaluation {
  id              Int                              @id @default(autoincrement())
  enrollment_id   Int
  evaluation_type courseevaluation_evaluation_type
  grade           String?                          @db.VarChar(50)
  rank            String?                          @db.VarChar(50)
  comments        String?                          @db.VarChar(50)
  course_topic_id Int
  created_at      DateTime                         @default(now()) @db.DateTime(0)
  evaluation_date DateTime                         @default(now()) @db.Timestamp(0)
  marks           Int?
  modified_at     DateTime?                        @default(now()) @db.DateTime(0)
  status          courseevaluation_status
  coursetopics    coursetopics                     @relation(fields: [course_topic_id], references: [id], map: "fk_Courseevluation_course_topic_id")
  enrollments     enrollments                      @relation(fields: [enrollment_id], references: [id], map: "fk_courseevaluation_enrollment_id")

  @@index([course_topic_id], map: "fk_Courseevluation_course_topic_id_idx")
  @@index([enrollment_id], map: "fk_courseevaluation_enrollment_id_idx")
}

model enrollmentpayments {
  id               Int                               @id @default(autoincrement())
  invoice_id       Int?
  paid_on          DateTime?                         @db.DateTime(0)
  bank_details     String?                           @db.VarChar(1000)
  transaction_no   String?                           @db.VarChar(100)
  comments         String?                           @db.Text
  payment_status   enrollmentpayments_payment_status
  paymentoption_id Int
  created_at       DateTime?                         @default(now()) @db.DateTime(0)
  modified_at      DateTime?                         @default(now()) @db.DateTime(0)
  invoices         invoices?                         @relation(fields: [invoice_id], references: [id], onDelete: Restrict, map: "fk_enrollmentpaymentdetails_invoice_id")
  paymentoptions   paymentoptions                    @relation(fields: [paymentoption_id], references: [id], map: "fk_enrollmentpaymentdetails_paymentoption_id")

  @@index([paymentoption_id], map: "fk_enrollmentpaymentdetails_idx")
  @@index([invoice_id], map: "fk_enrollmentpaymentdetails_invoice_id_idx")
}

model tenantbilling {
  id                        Int                        @id @default(autoincrement())
  bill_no                   DateTime                   @db.DateTime(0)
  bill_date                 DateTime                   @db.DateTime(0)
  branch_id                 Int
  tenantsubscriptiontier_id Int
  total_active_students     Int?
  amount_per_student        Decimal?                   @db.Decimal(10, 2)
  bill_total_amount         Decimal?                   @db.Decimal(10, 2)
  bill_status               tenantbilling_bill_status?
  created_at                DateTime?                  @db.DateTime(0)
  modified_at               DateTime?                  @default(now()) @db.DateTime(0)
  branches                  branches                   @relation(fields: [branch_id], references: [id], map: "fk_tenantbilling_bill_no")
  tenantsubscriptiontiers   tenantsubscriptiontiers    @relation(fields: [tenantsubscriptiontier_id], references: [id], map: "fk_tenantbilling_tenantsubscriptiontier_id")
  tenantpayments            tenantpayments[]

  @@index([branch_id], map: "fk_tenantbilling_bill_no_idx")
  @@index([tenantsubscriptiontier_id], map: "fk_tenantbilling_tenantsubscriptiontier_id_idx")
}

model tenantpayments {
  id               Int                            @id @default(autoincrement())
  bill_id          Int?
  paid_on          DateTime?                      @db.DateTime(0)
  bank_details     String?                        @db.VarChar(1000)
  transaction_no   String?                        @db.VarChar(100)
  comments         String?                        @db.Text
  payment_status   tenantpayments_payment_status?
  paymentoption_id Int
  created_at       DateTime?                      @default(now()) @db.DateTime(0)
  modified_at      DateTime?                      @default(now()) @db.DateTime(0)
  tenantbilling    tenantbilling?                 @relation(fields: [bill_id], references: [id], onDelete: Restrict, map: "fk_tenantpayments_bill_id")
  paymentoptions   paymentoptions                 @relation(fields: [paymentoption_id], references: [id], map: "fk_tenantpayments_paymentoption_id")

  @@index([bill_id], map: "fk_tenantpayments_bill_id_idx")
  @@index([paymentoption_id], map: "fk_tenantpayments_paymentoption_id_idx")
}

model tenantsubscriptiontiers {
  id                  Int                   @id @default(autoincrement())
  name                String                @db.VarChar(255)
  student_count_min   Int
  student_count_max   Int
  start_date          DateTime?             @db.Date
  end_date            DateTime?             @db.Date
  price_per_student   Decimal               @db.Decimal(10, 2)
  billing_cycle       String                @db.VarChar(50)
  created_at          DateTime?             @default(now()) @db.DateTime(0)
  modified_at         DateTime?             @default(now()) @db.DateTime(0)
  tenantbilling       tenantbilling[]
  tenantsubscriptions tenantsubscriptions[]
}

enum batches_medium {
  Offline
  Online
  Hybrid
}

enum enrollments_status {
  Applied
  Approved
  Active
  Completed
  Rejected
  Cancelled
  Dropped
  Waitlisted
}

enum products_status {
  Draft
  Published
  Archived
  Cancelled
}

enum staff_staff_title {
  Mr
  Mrs
  Ms
  Miss
  Dr
  Prof
}

enum courseevaluation_evaluation_type {
  Practice
  Mock
  Assessment
  Monthly
  Quarterly
  Annual
  Interim
  Final
}

enum courseprogress_status {
  Not_Started @map("Not Started")
  In_Progress @map("In Progress")
  Completed
  Withdrawn
}

enum courseevaluation_status {
  To_Do        @map("To Do")
  In_Progress  @map("In Progress")
  Submitted
  Under_Review @map("Under Review")
  Completed
  Cancelled
}

enum enrollmentpayments_payment_status {
  Pending
  Processing
  Success
  Failed
  Partially_Paid @map("Partially Paid")
  Refunded
  Cancelled
}

enum tenantpayments_payment_status {
  Pending
  Processing
  Success
  Failed
  Partially_Paid @map("Partially Paid")
  Refunded
  Cancelled
}

enum batches_status {
  Draft
  Open
  Closed
  Ongoing
  Completed
  Cancelled
}

enum tenantbilling_bill_status {
  Trial
  Active
  Pending_Payment @map("Pending Payment")
  Overdue
  Suspended
  Cancelled
  Expired
}

enum invoices_status {
  Draft
  Generated
  Due
  Overdue
  Pending
  Cancelled
}

enum staff_staff_status {
  Active
  Inactive
  On_Leave   @map("On Leave")
  Suspended
  Terminated
  Archived
  Quit
}
