generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "mysql"
}

model attendance {
  id            Int       @id @default(autoincrement())
  batch_id      Int
  enrollment_id Int
  date          DateTime  @db.Date
  status        String?   @db.VarChar(20)
  marked_by     Int?
  created_at    DateTime? @default(now()) @db.DateTime(0)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model batches {
  id           Int            @id @default(autoincrement())
  name         String         @db.VarChar(255)
  branch_id    Int
  weekdays     String?        @db.VarChar(50)
  start_time   DateTime?      @db.Time(0)
  end_time     DateTime?      @db.Time(0)
  max_students Int            @default(0)
  medium       batches_medium
  status       String?        @db.VarChar(50)
  created_at   DateTime?      @default(now()) @db.DateTime(0)
  updated_at   DateTime?      @default(now()) @db.DateTime(0)
}

model branches {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(255)
  contact_email String?   @db.VarChar(255)
  phone         String?   @db.VarChar(50)
  address       String?   @db.Text
  gst           String?   @db.VarChar(100)
  tenant_id     Int
  created_at    DateTime? @default(now()) @db.DateTime(0)
  updated_at    DateTime? @default(now()) @db.DateTime(0)
}

model courseprogress {
  id              Int       @id @default(autoincrement())
  course_topic_id Int
  enrollment_id   Int
  status          Boolean
  completed_on    DateTime? @default(now()) @db.Timestamp(0)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model coursetopics {
  id                Int       @id @default(autoincrement())
  course_topic_name String?   @db.VarChar(100)
  product_id        Int
  parent_id         Int       @default(0)
  IsActive          Int?      @default(1) @db.TinyInt
  created_at        DateTime? @default(now()) @db.Timestamp(0)
  modified_at       DateTime? @default(now()) @db.Timestamp(0)
  products          products  @relation(fields: [product_id], references: [id], map: "fk_topics_productid")

  @@index([product_id], map: "fk_topics_productid_idx")
}

model enrollmentbatches {
  id            Int       @id @default(autoincrement())
  enrollment_id Int
  batch_id      Int
  created_at    DateTime? @default(now()) @db.DateTime(0)
  updated_at    DateTime? @default(now()) @db.DateTime(0)
}

model enrollmentpaymentdetails {
  id               Int       @id @default(autoincrement())
  enrollment_id    Int
  paymentoption_id Int
  created_at       DateTime? @default(now()) @db.DateTime(0)
  updated_at       DateTime? @default(now()) @db.DateTime(0)
}

model enrollments {
  id             Int       @id @default(autoincrement())
  product_id     Int
  student_id     Int
  enrolled_date  DateTime? @db.DateTime(0)
  completed_date DateTime? @db.DateTime(0)
  dropped_date   DateTime? @db.DateTime(0)
  start_date     DateTime? @db.Date
  end_date       DateTime? @db.Date
  status         String?   @db.VarChar(50)
  created_at     DateTime? @default(now()) @db.DateTime(0)
  updated_at     DateTime? @default(now()) @db.DateTime(0)
}

model institutionbilling {
  id                    Int       @id @default(autoincrement())
  branch_id             Int
  subscriptiontier_id   Int
  month_year            String?   @db.VarChar(7)
  total_active_students Int?
  amount_per_student    Decimal?  @db.Decimal(10, 2)
  total_amount          Decimal?  @db.Decimal(10, 2)
  status                String?   @db.VarChar(50)
  generated_at          DateTime? @db.DateTime(0)
  paid_at               DateTime? @db.DateTime(0)
}

model invoices {
  id           Int       @id @default(autoincrement())
  branch_id    Int
  student_id   Int
  product_id   Int
  period_start DateTime? @db.Date
  period_end   DateTime? @db.Date
  due_date     DateTime? @db.Date
  amount       Decimal   @db.Decimal(10, 2)
  status       String?   @db.VarChar(50)
  created_at   DateTime? @default(now()) @db.DateTime(0)
  updated_at   DateTime? @default(now()) @db.DateTime(0)
}

model notifications {
  id         Int       @id @default(autoincrement())
  branch_id  Int
  title      String?   @db.VarChar(255)
  message    String?   @db.Text
  type       String?   @db.VarChar(50)
  created_at DateTime? @default(now()) @db.DateTime(0)
}

model paymentoptions {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(255)
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @default(now()) @db.DateTime(0)
}

model payments {
  id          Int       @id @default(autoincrement())
  invoice_id  Int
  paid_on     DateTime? @db.DateTime(0)
  transaction String?   @db.VarChar(50)
  comments    String?   @db.VarChar(1000)
  created_at  DateTime? @default(now()) @db.DateTime(0)
  updated_at  DateTime? @default(now()) @db.DateTime(0)
}

model performance {
  id            Int       @id @default(autoincrement())
  tenant_id     Int
  enrollment_id Int
  marks         Decimal?  @db.Decimal(5, 2)
  remarks       String?   @db.Text
  evaluated_by  Int?
  created_at    DateTime? @default(now()) @db.DateTime(0)
}

model productfees {
  id         Int       @id @default(autoincrement())
  product_id Int
  fee        Decimal   @db.Decimal(10, 2)
  start_date DateTime? @db.Date
  end_date   DateTime? @db.Date
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @default(now()) @db.DateTime(0)
}

model products {
  id           Int            @id @default(autoincrement())
  branch_id    Int
  name         String         @db.VarChar(255)
  description  String?        @db.Text
  max_classes  Int?
  comp_classes Int?
  start_date   DateTime?      @db.Date
  end_date     DateTime?      @db.Date
  created_at   DateTime?      @default(now()) @db.DateTime(0)
  updated_at   DateTime?      @default(now()) @db.DateTime(0)
  coursetopics coursetopics[]
}

model staff {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(200)
  qualification  String?   @db.VarChar(100)
  experience     String?   @db.VarChar(100)
  specialization String?   @db.VarChar(100)
  salary         Decimal?  @db.Decimal(10, 2)
  start_date     DateTime? @db.Date
  end_date       DateTime? @db.Date
  branch_id      Int
  user_id        Int?
  created_at     DateTime? @default(now()) @db.DateTime(0)
  updated_at     DateTime? @default(now()) @db.DateTime(0)
}

model staffmappings {
  id         Int       @id @default(autoincrement())
  branch_id  Int
  batch_id   Int
  product_id Int?
  staff_id   Int
  created_at DateTime  @db.DateTime(0)
  updated_at DateTime? @default(now()) @db.DateTime(0)
}

model students {
  id                      Int       @id @default(autoincrement())
  branch_id               Int
  name                    String    @db.VarChar(255)
  email                   String?   @db.VarChar(255)
  phone                   String?   @db.VarChar(50)
  address                 String?   @db.Text
  parent_guardian_name    String?   @db.VarChar(255)
  parent_guardian_contact String?   @db.VarChar(50)
  parent_guardian_email   String?   @db.VarChar(255)
  status                  String?   @db.VarChar(50)
  created_at              DateTime? @default(now()) @db.DateTime(0)
  updated_at              DateTime? @default(now()) @db.DateTime(0)
}

model subscriptiontiers {
  id                Int       @id @default(autoincrement())
  name              String    @db.VarChar(255)
  student_count_min Int
  student_count_max Int
  start_date        DateTime? @db.Date
  end_date          DateTime? @db.Date
  price_per_student Decimal   @db.Decimal(10, 2)
  billing_cycle     String    @db.VarChar(50)
  created_at        DateTime? @default(now()) @db.DateTime(0)
  updated_at        DateTime? @default(now()) @db.DateTime(0)
}

model tenants {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(255)
  contact_email String?   @db.VarChar(255)
  phone         String?   @db.VarChar(50)
  address       String?   @db.Text
  gst           String?   @db.VarChar(100)
  created_at    DateTime? @default(now()) @db.DateTime(0)
  updated_at    DateTime? @default(now()) @db.DateTime(0)
}

model tenantsubscriptions {
  id                 Int       @id @default(autoincrement())
  tenant_id          Int
  subscriptiontierid Int
  start_date         DateTime  @db.Date
  end_date           DateTime? @db.Date
  created_at         DateTime? @default(now()) @db.DateTime(0)
  updated_at         DateTime? @default(now()) @db.DateTime(0)
}

model users {
  id         Int       @id @default(autoincrement())
  tenant_id  Int?
  name       String    @db.VarChar(255)
  email      String    @unique(map: "email") @db.VarChar(255)
  password   String    @db.VarChar(255)
  role       String    @db.VarChar(50)
  is_active  Boolean?  @default(true)
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @default(now()) @db.DateTime(0)
}

enum batches_medium {
  Offline
  Online
  Hybrid
}
